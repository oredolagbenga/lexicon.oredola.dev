
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id Int @id @default(autoincrement()) name String email String @unique passwordHash String @map("password_hash") role Role @default(contributor) createdAt DateTime @default(now()) @map("created_at") words Word[] notifications Notification[] audios WordAudio[] @@map("users") }
model Word { id Int @id @default(autoincrement()) word String tonedWord String @map("toned_word") meaning String @db.Text partOfSpeech String? @map("part_of_speech") exampleSentence String? @map("example_sentence") @db.Text translation String? @db.Text category String? @default("General") status Status @default(pending) audioStatus Status @default(pending) @map("audio_status") audioPath String? @map("audio_path") @db.Text audioPublicId String? @map("audio_public_id") userId Int @map("user_id") user User @relation(fields: [userId], references: [id], onDelete: Cascade) createdAt DateTime @default(now()) @map("created_at") audios WordAudio[] notifications Notification[] @@index([word]) @@index([status]) @@index([category]) @@map("words") }
model Notification { id Int @id @default(autoincrement()) userId Int @map("user_id") user User @relation(fields: [userId], references: [id], onDelete: Cascade) wordId Int? @map("word_id") word Word? @relation(fields: [wordId], references: [id], onDelete: Cascade) message String @db.Text isRead Boolean @default(false) @map("is_read") createdAt DateTime @default(now()) @map("created_at") @@map("notifications") }
model WordAudio { id Int @id @default(autoincrement()) wordId Int @map("word_id") word Word @relation(fields: [wordId], references: [id], onDelete: Cascade) userId Int @map("user_id") user User @relation(fields: [userId], references: [id], onDelete: Cascade) audioFile String @map("audio_file") @db.Text audioUrl String? @map("audio_url") audioPublicId String? @map("audio_public_id") status Status @default(pending) approvedBy Int? @map("approved_by") createdAt DateTime @default(now()) @map("created_at") @@map("word_audio") }
enum Role { contributor admin }
enum Status { pending approved rejected }
